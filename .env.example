# Everything is optional for local use. With nothing set, `npm run dev` uses
# the file store in data/local/ (seeded from the synthetic data/seed.json)
# and the admin panel is open.

# Storage backend: memory | file | netlify.
# Default: netlify when running on Netlify (NETLIFY=true), otherwise file.
STORE_BACKEND=
# Folder for the file backend (default: data/local).
LOCAL_STORE_DIR=

# Netlify Blobs credentials. Only needed when the netlify backend runs outside
# Netlify's own function runtime; inside a deployed function they come from the request.
SITE_ID=
NETLIFY_AUTH_TOKEN=

# Admin panel password, checked server-side. Required on Netlify: without it
# admin routes return 503. Locally, leave empty for an open panel.
ADMIN_PASSWORD=
# Optional key for signing admin session tokens (defaults to one derived from ADMIN_PASSWORD).
SESSION_SECRET=

# Optional key agent workflows send as X-Api-Key on the read routes
# (getValue, getAllValues, getFilteredValues, getAllParentIds). Empty = reads are open.
AGENT_API_KEY=

# Optional: require an HMAC-SHA512 of the raw body in X-Webhook-Hmac on the receiver.
INBOUND_HMAC_SECRET=

# Set to false to keep raw payloads (message text) out of the incoming log.
LOG_RAW_PAYLOADS=

# Local server
PORT=8888
